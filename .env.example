# Azure OpenAI (gpt-5.4-mini)
# Portal: https://oai.azure.com/  — deployment name must match AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_ENDPOINT=https://mtr-project.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_MODEL_NAME=gpt-5.4-mini

# Serper Google Search API key (https://serper.dev/)
# Used by multi_search_api.SmartSearchTool for web / news lookup
SERPER_API_KEY=...

# --- Discord channel broadcast ---
# Create an application at https://discord.com/developers/applications
# Bot → Reset Token → DISCORD_BOT_TOKEN
# Invite the bot to your server with Send Messages + Read Message History.
# Enable Developer Mode in Discord → right-click the target channel → Copy Channel ID.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=123456789012345678
# Optional: override Hong Kong local broadcast time (default 09:00)
# DISCORD_BROADCAST_HOUR=9
# DISCORD_BROADCAST_MINUTE=0
